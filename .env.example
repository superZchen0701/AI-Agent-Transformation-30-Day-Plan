# DeepSeek API Key（必填，注册 https://platform.deepseek.com 获取）
DEEPSEEK_API_KEY=sk-xxx
# DeepSeek Base URL（可选，默认 https://api.deepseek.com）
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 打开千帆控制台 API Key 页面：console.bce.baidu.com/qianfan/ais/console/apiKey
# 点击「创建应用」（或选择已有应用），填写名称如 web-search-demo
# 在该应用下生成 API Key（新版格式形如 bce-v3/ALTAK-xxxx...）
# 复制保存——Secret Key 类密钥只显示一次
BAIDU_SEARCH_API_KEY=bce-v3/ALTAK-xxxx
# 内存管理环境变量（可选，默认 prod）
# prod：生产环境，用于实际生产
# test：测试环境，用于本地开发
MEMORY_MANAGER_ENV=prod
# Tavily API Key（必填，注册 https://app.tavily.com/playground 获取）
TAVILY_API_KEY=tvly-xxx
